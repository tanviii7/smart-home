# Smart Home AI Assistant Configuration
# Copy this file to .env.local to configure optional external services.

# Google Gemini API Key (Optional)
# If provided, enables Gemini 2.5 Flash live reasoning and tool calling.
# If omitted, the application runs on the built-in deterministic local intent engine.
VITE_GEMINI_API_KEY=

# Application Port
PORT=3000

# Device Bus Mode: 'simulated' | 'home_assistant_bridge'
VITE_DEVICE_BUS_MODE=simulated
